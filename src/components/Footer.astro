---
import { base, siteConfig } from '../utils/paths';

const year = new Date().getFullYear();
const links = [
	['Projects', `${base}projects/`],
	['Résumé', `${base}resume/`],
	['About', `${base}about/`],
	['Contact', `mailto:${siteConfig.contact.email}`],
	['LinkedIn', siteConfig.profiles.linkedin],
	['GitHub', siteConfig.profiles.github],
];
---

<footer class="site-footer">
	<nav aria-label="Footer navigation">{links.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
	<p>&copy; {year} {siteConfig.identity.name}</p>
</footer>

<style>
	.site-footer { width: min(1200px, calc(100% - 2rem)); margin: var(--space-3xl) auto 0; padding: var(--space-xl) 0; border-top: 1px solid var(--border); display: flex; justify-content: space-between; gap: var(--space-lg); color: var(--text-muted); }
	nav { display: flex; flex-wrap: wrap; gap: var(--space-md); }
	a { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-secondary); }
	p { align-self: center; font-size: 0.78rem; }
	@media (max-width: 700px) { .site-footer { align-items: flex-start; flex-direction: column; } }
</style>
