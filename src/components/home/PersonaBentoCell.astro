---
// src/components/home/PersonaBentoCell.astro
// Compact persona links cell (1x2 tall) for bento grid.

import personasData from '../../data/personas.json';
import { base } from '../../utils/paths';

const personas = personasData.personas;
---

<section class="bento-cell bento-cell--span-full persona-cell" aria-labelledby="role-fit-title">
	<h2 id="role-fit-title">Role-fit résumés</h2>
	<p class="persona-cell__intro">Audience-specific views of one career—not competing identities.</p>
	<nav class="persona-cell__list" aria-label="Resume personas">
		{
			personas.map((p) => (
				<a href={`${base}resume/${p.id}/`} class="persona-cell__link">
					<span class="persona-cell__title">{p.title}</span>
					<span class="persona-cell__arrow" aria-hidden="true">
						&rarr;
					</span>
				</a>
			))
		}
	</nav>
</section>

<style>
	.persona-cell {
		display: flex;
		flex-direction: column;
	}

	.persona-cell h2 { font: clamp(1.5rem, 3vw, 2.2rem)/1.15 var(--font-heading); }
	.persona-cell__intro { color: var(--text-secondary); margin: var(--space-xs) 0 var(--space-lg); }

	.persona-cell__list {
		display: flex;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-xs);
	}

	.persona-cell__link {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: var(--space-xs) var(--space-sm);
		border-radius: var(--radius-sm);
		text-decoration: none;
		color: var(--text-secondary);
		transition: all var(--transition-fast);
		min-height: 56px;
		border: 1px solid var(--border);
	}

	.persona-cell__link:hover {
		background: color-mix(in srgb, var(--accent) 8%, transparent);
		color: var(--accent);
	}

	.persona-cell__title {
		font-size: 0.85rem;
		line-height: 1.3;
	}

	.persona-cell__arrow {
		font-size: 0.85rem;
		color: var(--text-muted);
		transition: transform var(--transition-fast);
	}

	.persona-cell__link:hover .persona-cell__arrow {
		transform: translateX(3px);
		color: var(--accent);
	}
	@media (max-width: 800px) { .persona-cell__list { grid-template-columns: 1fr; } }
</style>
