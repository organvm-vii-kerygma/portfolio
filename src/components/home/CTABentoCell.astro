---
import { base } from '../../utils/paths';
---

<section class="bento-cell bento-cell--span-full cta-cell" aria-labelledby="next-step-title">
	<div>
		<p class="cta-cell__eyebrow">Choose the relevant next step</p>
		<h2 id="next-step-title">A clear door for each audience.</h2>
	</div>
	<div class="cta-cell__actions">
		<a href={`${base}consult/`} class="button button--primary">Discuss a systems audit</a>
		<a href={`${base}resume/`} class="button button--secondary">View role-fit résumé</a>
	</div>
</section>

<style>
	.cta-cell { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xl); }
	.cta-cell__eyebrow { color: var(--text-muted); font: 0.68rem/1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
	h2 { font: clamp(1.4rem, 3vw, 2.1rem)/1.15 var(--font-heading); margin-top: var(--space-sm); }
	.cta-cell__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
	.button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; border-radius: var(--radius-sm); padding: var(--space-sm) var(--space-lg); font: 700 0.8rem/1.2 var(--font-mono); text-decoration: none; }
	.button--primary { color: var(--text-on-accent); background: var(--accent); }
	.button--secondary { color: var(--text-primary); border: 1px solid var(--border-bright); background: var(--surface-subtle); }
	@media (max-width: 700px) { .cta-cell { align-items: flex-start; flex-direction: column; } .cta-cell__actions, .button { width: 100%; } }
</style>
