---
import rawSnapshot from '../../data/laurea-snapshot.json';
import { effectiveEvidenceState } from '../../utils/laurea-evidence';
import { siteConfig } from '../../utils/paths';

interface LaureaSnapshot {
	state: 'ready' | 'stale' | 'error' | 'withheld';
	generated_at: string | null;
	profile: { label: string } | null;
	public_claim: {
		claim_id: string;
		claim_status: 'verified' | 'derived_reviewed';
		evidence_state: 'ready';
		disclosure_level: 'L1' | 'L2' | 'L3';
		source_ref: string;
	} | null;
	limitations: string[];
	metrics: Record<string, number | null> & {
		contributions_trailing_12_months: number | null;
		non_fork_repositories_visible: number | null;
		pull_requests_opened_trailing_12_months: number | null;
		organization_memberships_queried: number | null;
	};
}
const snapshot = rawSnapshot as LaureaSnapshot;
const generatedMs = snapshot.generated_at ? Date.parse(snapshot.generated_at) : Number.NaN;
const hasValidTimestamp = Number.isFinite(generatedMs);
const evidenceState = effectiveEvidenceState(snapshot.state, snapshot.generated_at);
const publicClaim = snapshot.public_claim;
const isReady = Boolean(
	evidenceState === 'ready' &&
		snapshot.profile?.label === 'Measured GitHub activity profile' &&
		publicClaim &&
		['verified', 'derived_reviewed'].includes(publicClaim.claim_status) &&
		publicClaim.evidence_state === 'ready' &&
		publicClaim.claim_id &&
		publicClaim.disclosure_level &&
		publicClaim.source_ref,
);
const verifiedDate = hasValidTimestamp
	? new Date(generatedMs).toLocaleDateString('en-US', {
			month: 'short',
			day: 'numeric',
			year: 'numeric',
			timeZone: 'UTC',
		})
	: 'unavailable';
const metrics = [
	['GitHub contributions', snapshot.metrics.contributions_trailing_12_months, 'Trailing 12 months'],
	['Non-fork repositories', snapshot.metrics.non_fork_repositories_visible, 'Visible to the run'],
	[
		'Pull requests opened',
		snapshot.metrics.pull_requests_opened_trailing_12_months,
		'Trailing 12 months',
	],
	[
		'Organization memberships',
		snapshot.metrics.organization_memberships_queried,
		'Queried by LAVREA',
	],
];
---

<section
	class="bento-cell bento-cell--span-full laurea"
	aria-labelledby="laurea-title"
	data-evidence-state={evidenceState}
	data-claim-id={isReady ? publicClaim?.claim_id : undefined}
	data-claim-status={isReady ? publicClaim?.claim_status : undefined}
	data-disclosure-level={isReady ? publicClaim?.disclosure_level : undefined}
	data-source-ref={isReady ? publicClaim?.source_ref : undefined}
>
	<div class="laurea__meta">
		<p class="laurea__eyebrow">LAVREA / Computed evidence</p>
		<p>
			<a href={siteConfig.repositories.laurea}>organvm/laurea</a>
			<span aria-hidden="true"> · </span>
			<time datetime={hasValidTimestamp ? snapshot.generated_at ?? undefined : undefined}>Last verified {verifiedDate}</time>
		</p>
	</div>
	<h2 id="laurea-title">{isReady ? snapshot.profile?.label : 'A measured GitHub activity profile'}</h2>
	<p class="laurea__scope">
		{isReady
			? 'A bounded measurement of API-visible GitHub activity. It publishes no population ranking.'
			: evidenceState === 'stale'
				? 'The last source snapshot is older than 36 hours. Numeric activity claims are withheld until verification refreshes.'
				: 'The evidence source is unavailable or invalid. Numeric activity claims are withheld.'}
	</p>
	{
		isReady && (
			<dl class="laurea__metrics">
				{metrics.map(([label, value, qualifier]) => (
					<div>
						<dt>{label}</dt>
						<dd>
							{Number(value).toLocaleString()}
							<span class="laurea__qualifier">{qualifier}</span>
						</dd>
					</div>
				))}
			</dl>
		)
	}
	<p class="laurea__limitation">{snapshot.limitations[0]}</p>
	<div class="laurea__footer">
		<div class="laurea__links">
			<a href={`${siteConfig.repositories.laurea}/blob/main/METHODOLOGY.md`}>Methodology</a>
			<a href={`${siteConfig.repositories.laurea}/blob/main/assets/PROFILE.md`}>Full report</a>
		</div>
		{
			isReady && publicClaim && (
				<details class="laurea__provenance">
					<summary>Evidence record</summary>
					<dl>
						<div><dt>Status</dt><dd>{publicClaim.claim_status.replace('_', ' ')}</dd></div>
						<div><dt>Disclosure</dt><dd>{publicClaim.disclosure_level}</dd></div>
						<div><dt>Claim</dt><dd>{publicClaim.claim_id}</dd></div>
						<div><dt>Source</dt><dd>{publicClaim.source_ref}</dd></div>
					</dl>
				</details>
			)
		}
	</div>
	<div class="laurea__proof-rail" aria-hidden="true"><i></i><i></i><i></i></div>
</section>

<style>
	.laurea { position: relative; overflow: hidden; }
	.laurea__meta { display: flex; justify-content: space-between; gap: var(--space-md); align-items: baseline; }
	.laurea__meta p { color: var(--text-muted); font: 0.7rem/1.5 var(--font-mono); }
	.laurea__eyebrow { text-transform: uppercase; letter-spacing: 0.12em; }
	.laurea h2 { font: clamp(1.55rem, 3vw, 2.5rem)/1.1 var(--font-heading); margin: var(--space-lg) 0 var(--space-sm); }
	.laurea__scope, .laurea__limitation { max-width: 72ch; color: var(--text-secondary); line-height: 1.6; }
	.laurea__metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: var(--space-xl) 0; background: var(--border); border: 1px solid var(--border); }
	.laurea__metrics > div { background: var(--surface-evidence); padding: var(--space-lg); }
	.laurea dt, .laurea__qualifier { display: block; color: var(--text-muted); font: 0.68rem/1.4 var(--font-mono); }
	.laurea dd { color: var(--text-primary); font: 700 clamp(1.5rem, 3vw, 2.4rem)/1.2 var(--font-heading); margin: var(--space-xs) 0; }
	.laurea__limitation { font-size: 0.82rem; margin-top: var(--space-lg); }
	.laurea__footer { display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm) var(--space-xl); align-items: start; margin-top: var(--space-sm); }
	.laurea__links { display: flex; gap: var(--space-lg); }
	.laurea__links a { min-height: 44px; display: inline-flex; align-items: center; }
	.laurea__provenance { justify-self: end; color: var(--text-muted); font: 0.7rem/1.5 var(--font-mono); }
	.laurea__provenance[open] { grid-column: 1 / -1; justify-self: stretch; }
	.laurea__provenance summary { min-height: 44px; display: flex; justify-content: flex-end; align-items: center; color: var(--text-secondary); cursor: pointer; text-decoration: underline; text-underline-offset: 0.18em; }
	.laurea__provenance summary::before { content: '+ '; margin-right: var(--space-xs); text-decoration: none; }
	.laurea__provenance[open] summary::before { content: '\2212  '; }
	.laurea__provenance summary::marker { content: ''; }
	.laurea__provenance dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-xs) var(--space-md); margin: var(--space-xs) 0 var(--space-sm); padding-top: var(--space-md); border-top: 1px solid var(--border); }
	.laurea__provenance dl > div { display: contents; }
	.laurea__provenance dt { color: var(--text-muted); }
	.laurea__provenance dd { min-width: 0; margin: 0; color: var(--text-secondary); font: 0.7rem/1.5 var(--font-mono); overflow-wrap: anywhere; }
	.laurea__proof-rail { display: grid; grid-template-columns: repeat(3, 1fr); height: 3px; position: absolute; inset: auto 0 0; }
	.laurea__proof-rail i { background: rgb(var(--spectrum-complement)); animation: proof-shimmer 6s ease-in-out infinite; }
	.laurea__proof-rail i:nth-child(2) { background: rgb(var(--spectrum-current)); animation-delay: -2s; }
	.laurea__proof-rail i:nth-child(3) { background: rgb(var(--spectrum-primary)); animation-delay: -4s; }
	@keyframes proof-shimmer { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
	:global(html[data-ambient-motion='paused']) .laurea__proof-rail i { animation-play-state: paused; }
	@media (prefers-reduced-motion: reduce) {
		.laurea__proof-rail i { animation: none; opacity: 1; }
		:global(html[data-ambient-motion='running']) .laurea__proof-rail i { animation: proof-shimmer 6s ease-in-out infinite !important; }
	}
	@media (max-width: 900px) { .laurea__metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 520px) {
		.laurea__meta { align-items: flex-start; flex-direction: column; }
		.laurea__metrics { grid-template-columns: 1fr; }
		.laurea__footer { grid-template-columns: 1fr; }
		.laurea__provenance, .laurea__provenance[open] { grid-column: 1; justify-self: stretch; }
		.laurea__provenance summary { justify-content: flex-start; }
	}
</style>
