---
import AudienceDoor from '../components/home/AudienceDoor.astro';
import BentoGrid from '../components/home/BentoGrid.astro';
import CTABentoCell from '../components/home/CTABentoCell.astro';
import HeroBentoCell from '../components/home/HeroBentoCell.astro';
import LaurelsBentoCell from '../components/home/LaurelsBentoCell.astro';
import PersonaBentoCell from '../components/home/PersonaBentoCell.astro';
import SelectedProjectCard from '../components/home/SelectedProjectCard.astro';
import { projectCatalogBySlug } from '../data/project-catalog';
import Layout from '../layouts/Layout.astro';
import { base, siteConfig } from '../utils/paths';

const selectedSlugs = [
	'limen',
	'public-record-data-scrapper',
	'agentic-titan',
	'orchestration-hub',
];
const selectedProjects = selectedSlugs.map((slug) => {
	const project = projectCatalogBySlug.get(slug);
	if (!project) throw new Error(`Selected project missing from canonical catalog: ${slug}`);
	return project;
});
---

<Layout
	title={`${siteConfig.identity.name} — ${siteConfig.identity.role}`}
	description="Production-systems architecture for complex software delivery: governance, routing, verification, cost boundaries, evidence, and handoff."
	keywords={['Production systems', 'Systems architecture', 'Software delivery governance', 'Multi-agent systems', 'Staff engineer']}
>
	<BentoGrid>
		<HeroBentoCell />
		<AudienceDoor
			eyebrow="For clients"
			title="Make a risky initiative governable."
			description="A bounded, read-only entry point for diagnosing authority, routing, verification, and handoff failures."
			href={`${base}consult/`}
			action="Discuss a systems audit"
		/>
		<AudienceDoor
			eyebrow="For hiring teams"
			title="Evaluate the role fit."
			description="Audience-specific views of one career, with the same work, scope, and authorship boundaries."
			href={`${base}resume/`}
			action="View role-fit résumé"
		/>

		<header class="bento-section-heading bento-cell--span-full">
			<p>Evidence-led case studies</p>
			<h2>Selected work</h2>
		</header>
		{selectedProjects.map((project) => <SelectedProjectCard project={project} />)}
		<a href={`${base}projects/`} class="bento-cell bento-cell--span-full see-all">
			<span>See all projects</span><span aria-hidden="true">→</span>
		</a>

		<PersonaBentoCell />
		<LaurelsBentoCell />
		<CTABentoCell />
	</BentoGrid>
</Layout>

<style>
	.bento-section-heading { padding: var(--space-xl) 0 var(--space-sm); }
	.bento-section-heading p { color: var(--text-muted); font: 0.68rem/1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
	.bento-section-heading h2 { font: clamp(1.8rem, 4vw, 3rem)/1.1 var(--font-heading); margin-top: var(--space-xs); }
	.see-all { display: flex; min-height: 72px; align-items: center; justify-content: space-between; font-weight: 700; }
</style>
